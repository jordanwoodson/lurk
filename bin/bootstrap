#!/usr/bin/env bash
# Install or check everything the workspace needs. Safe to re-run.
source "$(dirname "$0")/lib/common.sh"

sha256() { if command -v sha256sum >/dev/null; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1; }

fetch() { # url dest sha256
    local url="$1" dest="$2" sum="$3"
    [[ -f "$dest" && "$(sha256 "$dest")" == "$sum" ]] && return
    note "downloading $(basename "$dest")"
    curl -fsSL -o "$dest.part" "$url"
    [[ "$(sha256 "$dest.part")" == "$sum" ]] || { rm -f "$dest.part"; die "checksum mismatch for $url"; }
    mv "$dest.part" "$dest"
}

note "JDK and Android SDK"
java -version 2>&1 | grep -q -E 'version "(2[1-9]|[3-9][0-9])' || die "JDK 21+ needed (JAVA_HOME=${JAVA_HOME:-unset})"
build_tool aapt2 >/dev/null
build_tool apksigner >/dev/null
[[ -d "$ANDROID_HOME/platforms/android-36" ]] || die "extensions need Android platform 36: sdkmanager 'platforms;android-36'"

note "mise tools: jadx, apkeep, hermes-dec, uv"
(cd "$ROOT" && mise trust -q && mise install -q)

note "jars in tools/"
mkdir -p "$TOOLS" "$WORK" "$MORPHE_DATA_DIR"
fetch "https://github.com/MorpheApp/morphe-desktop/releases/download/v$MORPHE_DESKTOP_VERSION/morphe-desktop-$MORPHE_DESKTOP_VERSION-all.jar" \
    "$MORPHE_DESKTOP_JAR" "$MORPHE_DESKTOP_SHA256"
fetch "https://github.com/iBotPeaches/Apktool/releases/download/v$APKTOOL_VERSION/apktool_$APKTOOL_VERSION.jar" \
    "$APKTOOL_JAR" "$APKTOOL_SHA256"

note "GitHub Packages (Morphe's Gradle plugin is only published there)"
github_packages_env
user="${GITHUB_ACTOR:-$(sed -n 's/^gpr.user *= *//p' "$HOME/.gradle/gradle.properties")}"
key="${GITHUB_TOKEN:-$(sed -n 's/^gpr.key *= *//p' "$HOME/.gradle/gradle.properties")}"
status="$(curl -s -o /dev/null -w '%{http_code}' -u "$user:$key" \
    https://maven.pkg.github.com/MorpheApp/registry/app/morphe/patches/app.morphe.patches.gradle.plugin/1.3.4/app.morphe.patches.gradle.plugin-1.3.4.pom)"
if [[ "$status" != 200 ]]; then
    die "GitHub Packages answered $status. Give the gh token read:packages: gh auth refresh -h github.com -s read:packages"
fi

note "ready. Morphe data (signing keystore): $MORPHE_DATA_DIR; work dir: $WORK"
