#!/usr/bin/env bash
# Decompile an app's base APK into $WORK/<app>/<version>/:
#   jadx/     Java sources and resources (jadx), for reading the code
#   apktool/  smali and decoded resources (apktool), for writing smali and checking registers
#   hermes/   Hermes disassembly and decompiled JS, React Native apps only (Kick)
# Usage: bin/decompile <app> [version] [--no-java] [--no-smali] [--no-hermes] [--force]
source "$(dirname "$0")/lib/common.sh"

slug="" version="" java=1 smali=1 hermes=1 force=""
for arg in "$@"; do
    case "$arg" in
        --no-java) java="" ;;
        --no-smali) smali="" ;;
        --no-hermes) hermes="" ;;
        --force) force=1 ;;
        -*) die "unknown option $arg" ;;
        *) if [[ -z "$slug" ]]; then slug="$arg"; else version="$arg"; fi ;;
    esac
done
[[ -n "$slug" ]] || die "usage: bin/decompile <app> [version] [--no-java] [--no-smali] [--no-hermes] [--force]"
version="$(app_version "$slug" "$version")"
input="$(app_input "$slug" "$version")"
out="$WORK/$slug/$version"
mkdir -p "$out"

# Skip a step whose output exists, unless --force.
fresh() { [[ -n "$force" ]] && rm -rf "$1"; [[ ! -e "$1" ]]; }

[[ -f "$out/base.apk" ]] || apk_py extract-base "$input" "$out/base.apk"

if [[ -n "$java" ]] && fresh "$out/jadx"; then
    note "jadx -> $out/jadx"
    # jadx exits non-zero when a few methods fail to decompile; the output is still usable.
    "$(tool jadx)" --log-level error --show-bad-code -d "$out/jadx" "$out/base.apk" >"$out/jadx.log" 2>&1 ||
        note "jadx reported errors (normal for big apps): $out/jadx.log"
fi

if [[ -n "$smali" ]] && fresh "$out/apktool"; then
    note "apktool -> $out/apktool"
    java -jar "$APKTOOL_JAR" d -f -p "$WORK/apktool-framework" -o "$out/apktool" "$out/base.apk" >"$out/apktool.log" 2>&1 ||
        die "apktool failed: $out/apktool.log"
fi

if [[ -n "$hermes" ]] && python3 -I -c 'import sys, zipfile; sys.exit("assets/index.android.bundle" not in zipfile.ZipFile(sys.argv[1]).namelist())' "$out/base.apk" &&
    fresh "$out/hermes"; then
    note "Hermes bundle found (React Native) -> $out/hermes"
    mkdir -p "$out/hermes"
    python3 -I -c 'import sys, zipfile; open(sys.argv[2], "wb").write(zipfile.ZipFile(sys.argv[1]).read("assets/index.android.bundle"))' \
        "$out/base.apk" "$out/hermes/index.android.bundle"
    "$(tool hbc-file-parser)" "$out/hermes/index.android.bundle" >"$out/hermes/header.txt" 2>&1 || true
    "$(tool hbc-disassembler)" "$out/hermes/index.android.bundle" "$out/hermes/disassembly.hasm" >"$out/hermes/disassembler.log" 2>&1 ||
        note "hbc-disassembler failed (unsupported bytecode version?): $out/hermes/disassembler.log"
    "$(tool hbc-decompiler)" "$out/hermes/index.android.bundle" "$out/hermes/decompiled.js" >"$out/hermes/decompiler.log" 2>&1 ||
        note "hbc-decompiler failed: $out/hermes/decompiler.log"
fi

echo "$out"
